        <mxCell id="aniQ9QHuZxmv1DUvEgxf-44" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;editableCssRules=.*;image=data:image/svg+xml,;" value="" vertex="1">
